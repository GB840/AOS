# 单创OS 商户后台网关配置
# Python AOS 内核（FastAPI）地址；所有 /api/aos/* 请求由 Node 网关转发到此。
AOS_BACKEND_URL=http://127.0.0.1:8000

# 前端启动端口（npm run dev / start）
PORT=3001

# ===== 网关鉴权（对齐 AGENTS.md §5「权限即边界」）=====
# 用户登录由网关转发到后端 /api/auth/token 换取 JWT，session 仅持有该 JWT。
# 网关不做本地凭据判断，前端不接触任何系统密钥。

# AOS_API_KEY：可选。若配置，网关转发时一并注入 x-api-key（双因子，向后兼容）。
AOS_API_KEY=changeme-internal-key

# session 签名密钥：务必改成随机长串；缺失则登录端点返回 500（fail-fast）。
AUTH_SECRET=change-me-to-a-long-random-secret

# 注意：已移除 demo 登录凭据（AUTH_USERNAME/AUTH_PASSWORD）。
# 登录凭据由后端 AOS API 的 /api/auth/token 负责校验。
