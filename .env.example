# =============================================================================
# AOS v5.0 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# =============================================================================
# cp .env.example .env

# ---- 基础配置 ----
APP_NAME=AOS Agentic OS v5.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# API 安全密钥（建议使用强随机字符串）
API_KEY=

# 允许的 CORS 来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:8000

# 每分钟最大请求数
MAX_REQUESTS_PER_MINUTE=100

# ---- 主 LLM Provider (Unified API) ----
# 用于默认聊天路由
UNIFIED_API_KEY=
UNIFIED_BASE_URL=https://api.deeproute.com/v1

# ---- 模型配置 ----
# 聊天模型
CHAT_MODEL_QWEN=qwen-qwen3.6-27b
CHAT_MODEL_MINIMAX=minimaxai-minimax-m2.5
CHAT_MODEL_DOUBAO=doubao-seed-2-0-lite-260428
CHAT_DEFAULT_MODEL=qwen-qwen3.6-27b

# 图片生成模型
IMAGE_MODEL_SEEDREAM=doubao-seedream-5-0-260128
IMAGE_MODEL_TONGYI=tongyi-mai-z-image-turbo
IMAGE_DEFAULT_MODEL=doubao-seedream-5-0-260128

# Embedding 模型
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32

# ASR 模型
ASR_MODEL=teleai-telespeechasr

# ---- Provider 1: 智谱 GLM ----
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash
ZHIPU_ENABLED=true

# ---- Provider 2: SiliconFlow ----
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V2.5
SILICONFLOW_ENABLED=true

# ---- Provider 3: 百度文心 ----
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_BASE_URL=https://aip.baidubce.com
BAIDU_MODEL=ernie-speed-128k
BAIDU_ENABLED=true

# ---- Provider 4: 讯飞语音 ----
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_MODEL=lite
XFYUN_ENABLED=true

# ---- Provider 5: Ollama (本地) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_ENABLED=true

# ---- 数据存储 ----
SQLITE_DB_PATH=data/sqlite/aos.db
CHROMADB_PERSIST_DIR=data/chroma
DATA_DIR=data
OUTPUTS_DIR=outputs

# ---- API 配置 ----
API_BASE_URL=http://localhost:8000

# ---- 向量存储 ----
VECTOR_ENABLED=true
VECTOR_COLLECTION_NAME=aos_memory

# ---- 动态路由配置 ----
ROUTER_CODING_PRIMARY=zhipu
ROUTER_HIGH_CONCURRENCY_PRIMARY=baidu
ROUTER_LONG_CONTEXT_PRIMARY=zhipu
ROUTER_VOICE_PRIMARY=xfyun
ROUTER_EXPERIMENT_PRIMARY=siliconflow
ROUTER_FALLBACK=ollama

# ---- MCP (Model Context Protocol) ----
MCP_ENABLED=true
MCP_VERSION=2024-11-05
MCP_SERVER_PORT=8001

# ---- 子智能体配置 ----
# OpenClaw (浏览器自动化 + 代码生成)
OPENCLAW_ENABLED=true
OPENCLAW_COMMAND=npx
OPENCLAW_CWD=external/jiuwenclaw
OPENCLAW_PATH=

# UI-TARS (桌面 GUI 自动化)
UITARS_ENABLED=true
UITARS_USE_MCP=false
UITARS_MCP_PORT=8090
UITARS_PATH=

# Lobster (办公自动化)
LOBSTER_ENABLED=true
LOBSTER_MODE=openclaw_bridge
LOBSTER_PORT=8091
LOBSTER_PATH=

# ---- 开源框架源码路径 (可选，如不填则使用 AOS 内置实现) ----
# Hermes Agent v0.15.2 (NousResearch): https://github.com/NousResearch/hermes-agent
HERMES_SOURCE_PATH=external/hermes-agent
HERMES_AGENT_PATH=external/hermes_agent

# DeerFlow 2.0 (ByteDance): https://github.com/bytedance/deer-flow
DEERFLOW_SOURCE_PATH=external/deer-flow/backend
DEERFLOW_HARNESS_PATH=external/deer-flow/backend/packages/harness
DEERFLOW_CONFIG_PATH=external/deer-flow/config.example.yaml

# ---- 外部工具路径 ----
AGENCY_AGENTS_PATH=external/agency-agents
AGENCY_AGENTS_ENABLED=true

OPEN_MONTAGE_PATH=external/open_montage
OPEN_MONTAGE_ENABLED=true

CODEBASE_MEMORY_PATH=external/codebase_memory_mcp
CODEBASE_MEMORY_ENABLED=true

OMNI_ROUTE_PATH=external/omni_route
OMNI_ROUTE_ENABLED=true

DESIGN_MD_PATH=external/design_md
DESIGN_MD_ENABLED=true

# ---- Llama.cpp (本地推理) ----
LLAMA_CPP_PATH=external/llama.cpp

# ---- 执行配置 ----
MAX_WORKERS=4
TASK_TIMEOUT=300
RETRY_ATTEMPTS=2

# ---- AOS fabric 外部引擎接线（本地固定 token，非密钥；仅用于本机引擎互通）----
OPENCLAW_GATEWAY_TOKEN=aos-fabric-2026local
# LiteLLM 推理平面默认模型（库模式，复用对应 provider key）
LITELLM_DEFAULT_MODEL=zhipu/glm-4-flash

# ---- Skills 系统 ----
SKILLS_ENABLED=true
SKILLS_AUTO_EVOLVE=true
SKILLS_OUTPUT_DIR=outputs/skills

# ---- ComfyUI 视觉生成 ----
COMFYUI_ENABLED=true
COMFYUI_BASE_URL=http://localhost:8188
COMFYUI_WORKFLOWS_DIR=src/skills/workflows
COMFYUI_OUTPUT_DIR=outputs/comfyui

# ---- Jina Reader (网页内容提取) ----
JINA_API_KEY=
JINA_READER_URL=https://r.jina.ai
JINA_API_URL=https://api.jina.ai/v1/extract

# ---- Cognee (知识图谱) ----
COGNEE_ENABLED=true
COGNEE_DATA_DIR=data/cognee
COGNEE_LOG_LEVEL=INFO

# ---- MCP 多源搜索 (AnySearch/OpenSearch) ----
AOS_MCP_SERVERS='[
  {
    "url": "http://anysearch:9200",
    "engine_id": "anysearch",
    "capability_map": {
      "search": "web.search"
    }
  }
]'

# ---- IMA 腾讯知识库 (OpenAPI) ----
# Client ID 由用户提供；API Key 从 https://ima.qq.com/agent-interface 获取
IMA_OPENAPI_CLIENTID=b1f8f7574dc75ac48e7bb0624ff72482
IMA_OPENAPI_APIKEY=

# ── AOS 自主环配置 ──
AOS_AUTOPILOT_USE_FABRICHUB=1          # 自主环路由开关（1=走FabricHub，0=本地适配器）
AOS_AUTOPILOT_DISTILL=1                # 自主环蒸馏开关（1=喂蒸馏器）
AOS_AUTOPILOT_MAX_DURATION=600         # 自主环最大时长（秒）
AOS_AUTOPILOT_MAX_LLM_CALLS=20         # 自主环最大LLM调用数
AOS_AG2_TIMEOUT=120                    # AG2引擎超时（秒）

# ── 模型网关配置 ──
AOS_ZHIPU_OPTIN=0                      # 智谱opt-in（1=显式启用闭源网关）
AOS_LLM_BASE_URL=                      # LLM基础URL（覆盖默认）
AOS_LLM_MODEL=                         # LLM模型名（覆盖默认）

# ── 记忆配置 ──
AOS_MEM0_LOCAL=1                       # mem0本地模式（1=本地零成本，0=远程key）
AOS_MEMORY_LIFECYCLE=1                 # 记忆生命周期（1=启用TTL淘汰）
AOS_TASK_MEMORY=1                      # 任务记忆（1=启用）

# ── 蒸馏与进化 ──
AOS_DISTILLER_ROUTE=1                  # 蒸馏器路由（1=启用白盒蒸馏路由）
AOS_DISTILLER_DROP=0                   # 蒸馏器丢弃（1=有可靠备选时跳过不可靠引擎）
AOS_DISTILLER_STORE=data/workspaces/fabric/distill.jsonl  # 蒸馏数据存储路径

# ── 安全与合规 ──
AOS_POLICY_ENFORCE=0                   # 合规策略执行（1=硬阻断，0=仅审计）
AOS_REPO_ROOT=                         # 仓库根目录（自动检测）
AOS_REPO_WRITE=0                       # 仓库写权限（1=允许commit）
AOS_REPO_PUSH=0                        # 仓库推送权限（1=允许push）

# ── MCP 服务 ──
WEKNORA_MCP_URL=                       # WeKnora MCP地址
WEKNORA_MCP_AUTH_TOKEN=                # WeKnora认证token
IDA_PRO_MCP_URL=                       # IDA Pro MCP地址（仅localhost）
AOS_CODEBASE_MCP_BIN=                  # codebase-memory二进制路径

# ── 外部MCP ──
DESKTOP_TOUCH_MCP_ENABLED=0            # 桌面触控MCP（1=启用）
OMNI_VIDEO_MCP_ENABLED=0               # 视频MCP（1=启用）
VIDEO_USE_MCP_ENABLED=0                # 视频USE MCP（1=启用）

# ── 可观测性 ──
LANGFUSE_PUBLIC_KEY=                   # Langfuse公钥
LANGFUSE_SECRET_KEY=                   # Langfuse密钥
LANGFUSE_HOST=                         # Langfuse地址

# ── 单创OS ──
DANCHUANG_ADMIN_KEY=                   # 单创OS管理员密钥
DANCHUANG_LLM_PROVIDER=                # 单创OS LLM供应商

# ── 支付 ──
ALIPAY_APP_ID=                         # 支付宝AppID
ALIPAY_PRIVATE_KEY=                    # 支付宝应用私钥
ALIPAY_PUBLIC_KEY=                     # 支付宝公钥
WECHAT_MCH_ID=                         # 微信商户号
WECHAT_API_KEY=                        # 微信API密钥
