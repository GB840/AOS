# =============================================================================
# Project-local data (kept on disk, never committed)
# =============================================================================
# 项目工作记忆（agent 长期记忆 / 日志），本地有用但不入库。
.workbuddy/
# agency_roles 迁移备份（269 文件，确认前保留磁盘、不入库、不删除）。
src/skills/agency_roles/_migrate_backup/
# scroll-world 等构建器的生成产物（真机出图/视频，体积大，不入库）。
out/
# 生命体伙伴运行时状态（Companion 持久化 JSON，运行时生成，不入库）。
.companion/

# =============================================================================
# Runtime artifacts & scratch (generated by agent runs / verification)
# =============================================================================
# agent 运行态产物（语义记忆 JSONL、checkpoint sqlite、任务 trace 等）——本地有用，不入库。
_traces/
# 临时验证 / 测试输出目录（含 pytest 日志、一次性脚本产物）。
_output/
# 视频生成中间产物。
_video_output/
# 工作流引擎运行时状态。
_workflow_state/
# 内容生产流水线运行时产物（ContentDirector：drafts/reviews/published）。
_content_work/
# 深度研究 / 草稿产物（非源码）。
.agnes/
# 一次性验证脚本（非交付物）。
reality_check.py
verify_output.py
tools/verify_*.py
# Agent 临时工作目录（沙箱/桌面客户端运行时产生的草稿、缓存）。
.scratch/

# ViMax 是自带 .git 的独立子仓库（577M），作为子模块/独立仓库管理，不混入 AOS。
ViMax/

# =============================================================================
# Root-level scratch / orphan skill（本地保留，绝不入库）
# =============================================================================
# 一次性草稿脚本（非交付物，误 add 会污染仓库）。
tmp_dream_query*.py
verify_*.py
test_bbq_full.py
test_bidding_e2e.py
test_system.py
# 放错位置的孤儿 skill 参考副本（代码不 import 它，真实依赖是 pip 包 crawl4ai）。
crawl4ai/
# 字面量 "~" 垃圾目录（内含 .mem0 运行时产物）。
/~
