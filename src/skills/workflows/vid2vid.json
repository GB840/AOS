{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "video": "{{video_path}}"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{prompt}}",
      "clip": ["3", 1]
    }
  },
  "3": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "sd-v1-5-inpainting.ckpt"
    }
  },
  "4": {
    "class_type": "SaveVideo",
    "inputs": {
      "filename_prefix": "aos_vid2vid",
      "frames": ["5", 0]
    }
  }
}